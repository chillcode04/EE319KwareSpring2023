#include <TimerOne.h> 
#include <MPU6050_tockn.h>
#include <Wire.h>
MPU6050 mpu6050(Wire);

#define LEFT_MOTOR_PIN  5
#define RIGHT_MOTOR_PIN 6
#define in1 4
#define in2 7
#define in3 8
#define in4 9

#define leftEncoder 2
#define rightEncoder 3
volatile int dem_a = 0;
volatile int dem_b = 0; 

double T = 0.01;
double Kp = 2, Ki = 0.01, Kd = 0.01;
double setpoint, targetTilt; 
double lasterror_Tilt = 0, error_Tilt; 
double input, outputDistance, lasterror_distance = 0, integral = 0, error_distance;

unsigned long turnStartTime = 0;  
bool turning = false;             
bool reachedSetpoint = false;     

enum State {MOVING_100CM_1, TURNING_RIGHT_1, MOVING_50CM_1, TURNING_RIGHT_2, MOVING_100CM_2, TURNING_RIGHT_3, MOVING_50CM_2, TURNING_RIGHT_4, STOPPED};
State currentState = MOVING_100CM_1;

void setup() 
{
  Serial.begin(9600);
  Wire.begin();
  mpu6050.begin();
  mpu6050.calcGyroOffsets(true);
  mpu6050.update(); 
  targetTilt = mpu6050.getAngleZ();
  
  // Motor pins
  pinMode(LEFT_MOTOR_PIN, OUTPUT);
  pinMode(in1, OUTPUT);
  pinMode(in2, OUTPUT);
  pinMode(in3, OUTPUT);
  pinMode(in4, OUTPUT);
  pinMode(RIGHT_MOTOR_PIN, OUTPUT);

  // Encoder pins
  pinMode(leftEncoder, INPUT);
  pinMode(rightEncoder, INPUT);

  // Interrupts for encoders
  attachInterrupt(digitalPinToInterrupt(rightEncoder), dem_xung_b, RISING);

  // Timer for PID
  Timer1.initialize(10000);  
  Timer1.attachInterrupt(pid);
}

void dem_xung_b() {
  dem_b++;
}

void motor_forward() {
  digitalWrite(in1, HIGH);
  digitalWrite(in2, LOW);
  digitalWrite(in3, HIGH);
  digitalWrite(in4, LOW);
}

void motor_stop() {
  digitalWrite(in1, LOW);
  digitalWrite(in2, LOW);
  digitalWrite(in3, LOW);
  digitalWrite(in4, LOW);
}

void motor_turn_right(int pwm) {
  if (!turning) {
    turnStartTime = millis();
    turning = true;

    analogWrite(LEFT_MOTOR_PIN, pwm); 
    analogWrite(RIGHT_MOTOR_PIN, pwm);

    digitalWrite(in1, HIGH);  // Động cơ trái quay tới
    digitalWrite(in2, LOW);

    digitalWrite(in3, LOW);   // Động cơ phải quay lùi
    digitalWrite(in4, HIGH);
  }
}

void pid() {
  mpu6050.update();
  double tiltAngle = mpu6050.getAngleZ();
  error_Tilt = targetTilt - tiltAngle; 

  double Pout = Kp * error_Tilt;
  integral += error_Tilt * T;
  double Iout = Ki * integral;
  double derivative = (error_Tilt - lasterror_Tilt) / T;
  double Dout = Kd * derivative;
  lasterror_Tilt = error_Tilt

  outputTilt = Pout + Iout + Dout;

  input = (float)(dem_b /20 ) * (6.6 * 3.14); 
  error_distance = setpoint - input;

  double Pout = Kp * error_distance;
  integral += error_distance * T;
  double Iout = Ki * integral;
  double derivative = (error_distance - lasterror_distance) / T;
  double Dout = Kd * derivative;

  outputDistance = Pout + Iout + Dout;
  lasterror_distance = error_distance;

  int leftMotorSpeed = constrain(150 + outputTilt + outputDistance, 0, 255);
  int rightMotorSpeed = constrain(150 - outputTilt + outputDistance, 0, 255);

  analogWrite(LEFT_MOTOR_PIN, leftMotorSpeed);
  analogWrite(RIGHT_MOTOR_PIN, rightMotorSpeed);

  if (abs(input - setpoint) < 3.0) {
    reachedSetpoint = true;
  }
}

void loop() {
  switch (currentState) {
    case MOVING_100CM_1:
      setpoint = 100;  // Di chuyển 100 cm
      if (reachedSetpoint) {
        currentState = TURNING_RIGHT_1;
        dem_a = 0;
        dem_b = 0;
        reachedSetpoint = false;
      } else {
        motor_forward();
      }
      break;

    case TURNING_RIGHT_1:
      // Tắt tất cả các ngắt
      detachInterrupt(digitalPinToInterrupt(leftEncoder));
      detachInterrupt(digitalPinToInterrupt(rightEncoder));
      Timer1.detachInterrupt();

      motor_turn_right(70); 
      if (millis() - turnStartTime >= 500) {  
        currentState = MOVING_50CM_1;
        dem_a = 0;
        dem_b = 0;
        turning = false;

        // Bật lại tất cả các ngắt
        attachInterrupt(digitalPinToInterrupt(leftEncoder), dem_xung_a, RISING);
        attachInterrupt(digitalPinToInterrupt(rightEncoder), dem_xung_b, RISING);
        Timer1.attachInterrupt(pid);
      }
      break;

    case MOVING_50CM_1:
      setpoint = 50;  // Di chuyển 50 cm
      if (reachedSetpoint) {
        currentState = TURNING_RIGHT_2;
        dem_a = 0;
        dem_b = 0;
        reachedSetpoint = false;
      } else {
        motor_forward();
      }
      break;

    case TURNING_RIGHT_2:
      detachInterrupt(digitalPinToInterrupt(leftEncoder));
      detachInterrupt(digitalPinToInterrupt(rightEncoder));
      Timer1.detachInterrupt(); 

      motor_turn_right(70);  // Quay phải lần thứ 2
      if (millis() - turnStartTime >= 500) {
        currentState = MOVING_100CM_2;
        dem_a = 0;
        dem_b = 0;
        turning = false;

        attachInterrupt(digitalPinToInterrupt(leftEncoder), dem_xung_a, RISING);
        attachInterrupt(digitalPinToInterrupt(rightEncoder), dem_xung_b, RISING);
        Timer1.attachInterrupt(pid);
      }
      break;

    case MOVING_100CM_2:
      setpoint = 100;  // Di chuyển 100 cm lần thứ 2
      if (reachedSetpoint) {
        currentState = TURNING_RIGHT_3;
        dem_a = 0;
        dem_b = 0;
        reachedSetpoint = false;
      } else {
        motor_forward();
      }
      break;

    case TURNING_RIGHT_3:
      detachInterrupt(digitalPinToInterrupt(leftEncoder));
      detachInterrupt(digitalPinToInterrupt(rightEncoder));
      Timer1.detachInterrupt(); // Tắt ngắt timer

      motor_turn_right(70);  // Quay phải lần thứ 3
      if (millis() - turnStartTime >= 500) {
        currentState = MOVING_50CM_2;
        dem_a = 0;
        dem_b = 0;
        turning = false;

        attachInterrupt(digitalPinToInterrupt(leftEncoder), dem_xung_a, RISING);
        attachInterrupt(digitalPinToInterrupt(rightEncoder), dem_xung_b, RISING);
        Timer1.attachInterrupt(pid); // Bật lại ngắt timer
      }
      break;

    case MOVING_50CM_2:
      setpoint = 50;  // Di chuyển 50 cm lần thứ 2
      if (reachedSetpoint) {
        currentState = TURNING_RIGHT_4;
        dem_a = 0;
        dem_b = 0;
        reachedSetpoint = false;
      } else {
        motor_forward();
      }
      break;

    case TURNING_RIGHT_4:
      detachInterrupt(digitalPinToInterrupt(leftEncoder));
      detachInterrupt(digitalPinToInterrupt(rightEncoder));
      Timer1.detachInterrupt(); // Tắt ngắt timer

      motor_turn_right(70);  // Quay phải lần thứ 4
      if (millis() - turnStartTime >= 500) {
        currentState = STOPPED; 
        turning = false;

        attachInterrupt(digitalPinToInterrupt(leftEncoder), dem_xung_a, RISING);
        attachInterrupt(digitalPinToInterrupt(rightEncoder), dem_xung_b, RISING);
        Timer1.attachInterrupt(pid); // Bật lại ngắt timer
      }
      break;

    case STOPPED:
      motor_stop();
      break;
  }

  Serial.print(" Distance: ");
  Serial.print(input);
  Serial.print(" Setpoint: ");
  Serial.print(setpoint);
  Serial.print(" error_distance: ");
  Serial.println(error_distance);
}
